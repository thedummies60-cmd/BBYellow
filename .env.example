# Copy to .env.local for local development.
#
# WARNING: every VITE_-prefixed variable is INLINED INTO THE PUBLIC BUNDLE.
# Anyone can read it by viewing source. Never put a secret, API key, or token
# here — this game ships as static files with no backend to hide anything behind.
# See CLAUDE.md §7.

# Base path when deployed to a subdirectory (leave as './' for relative)
VITE_BASE_PATH=./

# Build identifier shown on the title screen, for matching bug reports to commits
VITE_BUILD_ID=dev

# Enable the in-game debug/stats overlay (also toggleable with ?stats=1)
VITE_DEBUG_OVERLAY=false
